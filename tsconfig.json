{
  "compilerOptions": {
    "target": "ES2022", // Node 22
    "module": "commonjs",
    "moduleResolution": "node",
    // Bumping `target` to ES2022 would default this to `true`, changing class-field
    // init order (breaks the BaseService "constructor calls overridable setupService,
    // subclass declares `State = {...}`" pattern). Keep the pre-ES2022 semantics.
    "useDefineForClassFields": false,
    "removeComments": true,
    "lib": [
      "ES2022"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
